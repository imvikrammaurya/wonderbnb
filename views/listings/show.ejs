<% layout('layouts/boilerplate.ejs') -%>
<body>
  <div class="row mt-3">
    <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1">
      <div class="d-flex justify-content-between align-items-center">
  <h3><%= listing.title %></h3>

 <div class="d-flex">
  <%# Add a check for "typeof wishlist" to prevent crash if user is old %>
  <% const isSaved = (typeof wishlist !== 'undefined' && wishlist.some(savedId => savedId.equals(listing._id))); %>
  
  <button class="btn btn-outline-secondary btn-sm me-2 save-btn" data-listing-id="<%= listing._id %>">
     <i class="fa-<%= isSaved ? 'solid' : 'regular' %> fa-heart"></i> Save
  </button>
  <button class="btn btn-outline-secondary btn-sm" id="copy-link-btn">
    <i class="fa-solid fa-share-nodes"></i> Share
  </button>
</div>
</div>

      <div class="row">
        <div class="col-md-7">
          <div class="card mt-3 show-card listing-card border-0 mb-3">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing Image">
            <div class="card-body px-0">
              <p class="card-text"><i><b>Property Is Owned by:</b> <%= listing.owner.username %></i></p>
              <p><b>Description: </b><%= listing.description %></p>

<!-- Check if amenities exist and the array is not empty -->
<% if (listing.amenities && listing.amenities.length > 0) { %>
  <hr>
  <h5>What this place offers</h5>
  <div class="row row-cols-2 g-3 mb-3">
    <% for(let amenity of listing.amenities) { %>
      
      <% 
         let iconClass = 'fa-solid fa-question'; 
         switch (amenity) {
            case 'Wifi': iconClass = 'fa-solid fa-wifi'; break;
            case 'Air Conditioning': iconClass = 'fa-solid fa-snowflake'; break; 
            case 'TV': iconClass = 'fa-solid fa-tv'; break;
            case 'Kitchen': iconClass = 'fa-solid fa-kitchen-set'; break;
            case 'Pool': iconClass = 'fa-solid fa-person-swimming'; break;
            case 'Free Parking': iconClass = 'fa-solid fa-square-parking'; break;
            case 'Hot Tub': iconClass = 'fa-solid fa-hot-tub-person'; break;
            case 'Washer': iconClass = 'fa-solid fa-jug-detergent'; break; 
            case 'Dryer': iconClass = 'fa-solid fa-temperature-arrow-up'; break; 
            case 'Heating': iconClass = 'fa-solid fa-fire'; break;
            case 'Gym': iconClass = 'fa-solid fa-dumbbell'; break;
            case 'Breakfast': iconClass = 'fa-solid fa-mug-saucer'; break;
            case 'EV Charger': iconClass = 'fa-solid fa-charging-station'; break;
            case 'Pet Friendly': iconClass = 'fa-solid fa-paw'; break;
            case 'Power Backup': iconClass = 'fa-solid fa-bolt'; break;
            case 'Geyser': iconClass = 'fa-solid fa-faucet-drip'; break; 
            case 'Security Cameras': iconClass = 'fa-solid fa-camera-retro'; break;
            case 'Room Service': iconClass = 'fa-solid fa-bell-concierge'; break;
            case 'Restaurant': iconClass = 'fa-solid fa-utensils'; break;
            case 'Lift': iconClass = 'fa-solid fa-elevator'; break;
            case 'Conference Room': iconClass = 'fa-solid fa-briefcase'; break;
            
         }
      %>
      <div class="col-auto"> <%# Use col-auto so pills take only needed width %>
        <div class="amenity-pill"> <%# New class for styling %>
          <i class="<%= iconClass %> me-2"></i> <%# Added margin to icon %>
          <span><%= amenity %></span>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

              <% if (listing.averageRating > 0) { %>
                <%
                  let ratingClass = "";
                  if (listing.averageRating < 2) ratingClass = "rating-red";
                  else if (listing.averageRating <= 3.5) ratingClass = "rating-yellow";
                  else if (listing.averageRating <= 4.7) ratingClass = "rating-green";
                  else ratingClass = "rating-dark-green";
                %>
                <div class="show-rating mb-2">
                  <div class="rating-score <%= ratingClass %>"><b><i class="fa-solid fa-star"></i> <%= listing.averageRating.toFixed(1) %></b></div>
                  <div class="rating-count"><%= listing.reviews.length %> Rating<%= listing.reviews.length > 1 ? 's' : '' %></div>
                </div>
              <% } %>
              <% if (listing.category && listing.category.length > 0) { %>
                <h5 class="mt-3"><b>Categories</b></h5>
                <p>
                  <% for(let category of listing.category) { %>
                    <a href="/listings?category=<%= category %>" class="category-link badge rounded-pill text-bg-secondary me-2"><%= category %></a>
                  <% } %>
                </p>
              <% } %>
              <p><b>Location: </b><%= listing.location %></p>
              <p><b>Country: </b><%= listing.country %></p>
              <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
                <div class="btns mt-3 d-flex align-items-center">
                  <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger edit-btn me-2">Edit</a>
                  <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="me-2"><button class="btn btn-dark">Delete</button></form>
                  </div>
              <% } %>
            </div>
          </div>
          <!-- <hr> -->
        </div>

        <div class="col-md-5">
          <div class="booking-widget card shadow-sm mt-3 sticky-top">
            <div class="card-body">
              <h5 class="card-title price-display mb-3">
                <b>₹<span id="widget-price"><%= Number(displayPrice).toLocaleString("en-IN") %></span></b>
                <span id="price-label"><%= isTotalPrice ? ' total' : ' /night' %></span>
              </h5>
              <div class="row g-2 mb-3 date-guest-inputs">
                <div class="col-6">
                  <label for="widget-checkin" class="form-label small">CHECK-IN</label>
                  <input type="text" class="form-control" id="widget-checkin" placeholder="Add date">
                </div>
                <div class="col-6">
                  <label for="widget-checkout" class="form-label small">CHECKOUT</label>
                  <input type="text" class="form-control" id="widget-checkout" placeholder="Add date">
                </div>
                <div class="col-12 position-relative">
                   <label for="widget-guests" class="form-label small">GUESTS</label>
                   <input type="text" class="form-control" id="widget-guests" placeholder="Add guests" readonly>
                   <div id="widget-guest-dropdown" class="guest-dropdown-menu">
                      <div class="guest-option">
                        <span>Adults</span>
                        <div class="guest-counter">
                          <button type="button" class="counter-btn widget-counter-btn" data-type="adults" data-action="decrement">-</button>
                          <span id="widget-adults-count">1</span>
                          <button type="button" class="counter-btn widget-counter-btn" data-type="adults" data-action="increment">+</button>
                        </div>
                      </div>
                      <div class="guest-option">
                        <span>Children</span>
                        <div class="guest-counter">
                          <button type="button" class="counter-btn widget-counter-btn" data-type="children" data-action="decrement">-</button>
                          <span id="widget-children-count">0</span>
                          <button type="button" class="counter-btn widget-counter-btn" data-type="children" data-action="increment">+</button>
                        </div>
                      </div>
                   </div>
                </div>
              </div>
              <a href="/listings/<%= listing._id %>/payment?price=<%= displayPrice %>" id="reserve-button" class="btn btn-danger add-btn w-100">Reserve</a>
              <p class="text-muted text-center small mt-2">You won't be charged yet</p>
            </div>
          </div>
        </div>
      </div>

      <hr class="mt-4">
      <div class="mt-3 mb-3">
        <% if(currUser) {%>
          <h4>Leave a Review</h4>
          <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
             <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
      </div>

      <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
          <div class="invalid-feedback">Please Add Some Comment For Review</div>
      </div>

      <button class="btn btn-outline-dark">Submit</button>
  </form>
        <% } %>
      </div>
      <div class="row mt-4">
  <h5><b>All Reviews</b></h5>
  <% if (listing.reviews && listing.reviews.length > 0) { %> 
      <% for(review of listing.reviews) { %>
        <div class="col-md-6 mb-3">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title mt-2 px-2">@<%= review.author ? review.author.username : 'Deleted User' %></h5> 
              <p class="starability-result card-text " data-rating="<%= review.rating %>"></p>
              <p class="card-text px-3"><%= review.comment %></p>
            </div>
            <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %> 
              <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3 ms-3" method="POST">
                <button class="btn btn-sm btn-dark mt-2">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>
  <% } else { %>
      <p>No reviews yet.</p> 
  <% } %>
</div>
    </div>
  </div>
  <script>
document.addEventListener('DOMContentLoaded', () => {
  

    // --- Initialize Navbar Guest Selection (if navbar exists) ---
    function initGuestSelection(guestInputId, guestDropdownId, adultsCountId, childrenCountId, startAdults = 1, startChildren = 0, priceUpdateCallback = null) {
        const guestInput = document.getElementById(guestInputId);
        const guestDropdown = document.getElementById(guestDropdownId);
        if (!guestInput || !guestDropdown) return null; 

        const adultsCountEl = document.getElementById(adultsCountId);
        const childrenCountEl = document.getElementById(childrenCountId);
        let adults = startAdults;
        let children = startChildren;

        if (adultsCountEl) adultsCountEl.textContent = adults;
        if (childrenCountEl) childrenCountEl.textContent = children;

        function updateGuestInput() {
            let guestText = `${adults} Adult${adults > 1 ? 's' : ''}`;
            if (children > 0) guestText += `, ${children} Child${children > 1 ? 'ren' : ''}`;
            guestInput.value = guestText;
        }
        updateGuestInput();

        guestInput.addEventListener('click', (event) => {
            event.stopPropagation();
            // Close other dropdowns if any
            document.querySelectorAll('.guest-dropdown-menu').forEach(el => {
                if(el !== guestDropdown) el.style.display = 'none';
            });
            guestDropdown.style.display = guestDropdown.style.display === 'block' ? 'none' : 'block';
        });

        guestDropdown.addEventListener('click', (event) => {
            if (event.target.classList.contains('counter-btn')) {
                const type = event.target.dataset.type;
                const action = event.target.dataset.action;
                if (type === 'adults') {
                    adults = action === 'increment' ? Math.min(4, adults + 1) : Math.max(1, adults - 1);
                    adultsCountEl.textContent = adults;
                } else {
                    children = action === 'increment' ? Math.min(2, children + 1) : Math.max(0, children - 1);
                    childrenCountEl.textContent = children;
                }
                updateGuestInput();
                // Call the price update function if provided
                if (priceUpdateCallback) setTimeout(priceUpdateCallback, 50);
            }
        });
        
        // Return a function to get current guest values
        return () => ({ adults, children, guestString: guestInput.value });
    }

    // Initialize guest selection for the NAVBAR (if present)
    const getNavbarGuests = initGuestSelection('guests', 'guest-dropdown', 'adults-count', 'children-count');

    // Close navbar dropdown when clicking outside
    document.addEventListener('click', (event) => {
        const guestInput = document.getElementById('guests');
        const guestDropdown = document.getElementById('guest-dropdown');
        if (guestDropdown && guestInput && !guestInput.contains(event.target) && !guestDropdown.contains(event.target)) {
            guestDropdown.style.display = 'none';
        }
    });

    // --- Booking Widget Logic ---
    const widgetCheckinInput = document.getElementById('widget-checkin');
    const widgetCheckoutInput = document.getElementById('widget-checkout');
    const widgetGuestsInput = document.getElementById('widget-guests');
    const widgetPriceElement = document.getElementById('widget-price');
    const widgetPriceLabel = document.getElementById('price-label');
    const reserveButton = document.getElementById('reserve-button');
    const listingId = "<%= listing._id %>";

    // Initialize guest selection for the WIDGET, passing updatePrice as the callback
    const getWidgetGuests = initGuestSelection('widget-guests', 'widget-guest-dropdown', 'widget-adults-count', 'widget-children-count', 1, 0, updatePrice);

    

    // Dynamic Price Update Function
    async function updatePrice() {
        if (!widgetCheckinInput || !widgetCheckoutInput || !widgetGuestsInput || !widgetPriceElement || !getWidgetGuests) return;

        const checkinDate = widgetPicker.getStartDate();
        const checkoutDate = widgetPicker.getEndDate();
        const { guestString } = getWidgetGuests(); // Get current guest string from widget

        if (!checkinDate || !checkoutDate || !guestString) return; // Don't update if dates/guests not set


        // Helper function to format Date object to YYYY-MM-DD
    function formatDate(date) {
        const d = new Date(date);
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0'); // Months are 0-indexed
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }


        // Format dates correctly for Litepicker output and URL
        const startDateStr = formatDate(checkinDate.toJSDate()); // Convert Litepicker date to JS Date, then format
    const endDateStr = formatDate(checkoutDate.toJSDate()); 
    const datesParam = `${startDateStr} - ${endDateStr}`;
        


    console.log("Sending Dates:", datesParam);


        const url = `/listings/${listingId}/calculate-price?dates=${encodeURIComponent(datesParam)}&guests=${encodeURIComponent(guestString)}`;

        try {
            const response = await fetch(url);
            if (!response.ok) throw new Error('Price calculation failed');
            const data = await response.json();

            widgetPriceElement.textContent = data.newPrice.toLocaleString('en-IN');
            widgetPriceLabel.textContent = ' total'; // Always show 'total' when dates are selected

            // Update Reserve button link
            reserveButton.href = `/listings/${listingId}/payment?price=${data.newPrice}`;

        } catch (error) {
            console.error("Error updating price:", error);
            widgetPriceElement.textContent = 'N/A'; // Show error or default
            widgetPriceLabel.textContent = '';
        }
    }

    // Initialize Litepicker for the WIDGET
    const widgetPicker = new Litepicker({
        element: widgetCheckinInput,
        elementEnd: widgetCheckoutInput,
        singleMode: false,
        format: 'DD MMM YYYY', // Use a format that works for parsing
        minDate: new Date(), // Prevent booking past dates
        numberOfMonths: 1, // Show one month like Airbnb
        selectForward: true, // Only allow selecting future dates
        setup: (picker) => {
             picker.on('selected', (date1, date2) => {
                 updatePrice(); // Update price when dates are selected
             });
         }
    });
    const copyLinkBtn = document.getElementById('copy-link-btn');
    if (copyLinkBtn) {
        copyLinkBtn.addEventListener('click', async () => {
            const listingUrl = window.location.href; // Gets the current page URL
            const originalText = copyLinkBtn.innerHTML;

            try {
                // Try to copy the URL to the clipboard
                await navigator.clipboard.writeText(listingUrl);
                
                // Give user feedback:
                copyLinkBtn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
                copyLinkBtn.classList.add('btn-success');
                
                // Revert button text after 2 seconds
                setTimeout(() => {
                    copyLinkBtn.innerHTML = originalText;
                    copyLinkBtn.classList.remove('btn-success');
                }, 2000);

            } catch (err) {
                console.error('Failed to copy link: ', err);
                alert('Failed to copy link. Please copy it from your address bar.');
            }
        });
    }
});


</script>
</body>