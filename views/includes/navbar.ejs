<style>
  .search-btn{
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }

  .search-btn:hover{
    background-color: #fe424d;
    color: #ffff;
  }
  .search-btn i{
    display: inline;
    margin-right: 0.5rem;
  }
  .search-input{
    border-radius: 25px;
    padding: 0.5rem 4rem 0.5rem 4rem;
    font-size: 0.9rem;
  }
  
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <% if (typeof showFilterButton !== 'undefined' && showFilterButton) { %>
          <a class="nav-link" href="#" id="filter-btn" style="margin: 0.5rem;">
          <i class="fa-solid fa-bars" style="font-size: 1.25rem;"></i>&nbsp;
          </a>
    <% } %>
    <div class="d-flex d-md-none align-items-center w-100">
      <a class="navbar-brand" href="/listings"><i class="fa-solid fa-umbrella-beach"></i></a>
      
      <div class="search-bar-mobile-trigger flex-grow-1 mx-2" data-bs-toggle="modal" data-bs-target="#searchModal">
        <div class="search-bar-mobile-text">Search</div>
        <div class="search-bar-mobile-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
      </div>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <a class="navbar-brand d-none d-md-block" href="/listings"><i class="fa-solid fa-umbrella-beach"></i></a>

      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>

       
        
      </div>

      <div class="navbar-nav navbar-center d-none d-md-block">
        <form action="/listings/search" method="GET" class="d-flex search-bar">
          <div class="search-bar-item"><label for="location">Location</label><input type="text" id="location" name="location" placeholder="Search destinations" value="<%= (searchParams && searchParams.location) ? searchParams.location : '' %>"></div>
          <div class="search-bar-item"><label for="dates">Dates</label><input type="text" id="dates" name="dates" placeholder="Add dates" value="<%= (searchParams && searchParams.dates) ? searchParams.dates : '' %>"></div>
          <div class="search-bar-item guest-item"><label for="guests">Guests</label><input type="text" id="guests" name="guests" placeholder="Add guests" readonly></div>
          <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
      </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Wonderbnb your home</a>
        <% if(!currUser){ %><a class="nav-link" href="/signup"><b>Sign Up</b></a><a class="nav-link" href="/login"><b>Login</b></a><% } %>
        <% if(currUser){ %><a class="nav-link" href="/wishlist">Wishlist</a><a class="nav-link" href="/logout"><b>Logout</b></a><% } %>
      </div>
    </div>
  </div>
</nav>

<div id="guest-dropdown" class="guest-dropdown-menu">
    <div class="guest-option">
      <span>Adults</span>
      <div class="guest-counter">
        <button type="button" class="counter-btn" data-type="adults" data-action="decrement">-</button>
        <span id="adults-count">1</span>
        <button type="button" class="counter-btn" data-type="adults" data-action="increment">+</button>
      </div>
    </div>
    <div class="guest-option">
      <span>Children</span>
      <div class="guest-counter">
        <button type="button" class="counter-btn" data-type="children" data-action="decrement">-</button>
        <span id="children-count">0</span>
        <button type="button" class="counter-btn" data-type="children" data-action="increment">+</button>
      </div>
    </div>
</div>
<!-- Slide-in Sidebar -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <h5>Filters</h5>
        <button id="close-sidebar" class="close-btn">&times;</button>
    </div>
    <div class="sidebar-content">
        <form action="/listings" method="GET" id="filter-form">
            <!-- Preserve existing search params if any -->
            <% if (typeof searchParams !== 'undefined' && searchParams.location) { %>
                <input type="hidden" name="location" value="<%= searchParams.location %>">
            <% } %>
            <% if (typeof searchParams !== 'undefined' && searchParams.dates) { %>
                <input type="hidden" name="dates" value="<%= searchParams.dates %>">
            <% } %>
            <% if (typeof searchParams !== 'undefined' && searchParams.guests) { %>
                <input type="hidden" name="guests" value="<%= searchParams.guests %>">
            <% } %>
            <% if (typeof category !== 'undefined' && category) { %>
                <input type="hidden" name="category" value="<%= category %>">
            <% } %>

            <div class="filter-section">
                <h6>Sort By Price</h6>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="sort" id="price_asc" value="price_asc">
                    <label class="form-check-label" for="price_asc">Price: Low to High</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="sort" id="price_desc" value="price_desc">
                    <label class="form-check-label" for="price_desc">Price: High to Low</label>
                </div>
            </div>
            <hr>
            <div class="filter-section">
                <h6>Rating</h6>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="rating" id="rating_4" value="4">
                    <label class="form-check-label" for="rating_4">4+ Stars</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="rating" id="rating_3" value="3">
                    <label class="form-check-label" for="rating_3">3+ Stars</label>
                </div>
            </div>
            <hr>
            <div class="filter-section">
                <h6>Amenities</h6>
                <div class="amenities-grid">
                    <% const amenitiesList = ['Wifi', 'Air Conditioning', 'Pool', 'Kitchen', 'Free Parking', 'Hot Tub', 'Gym']; %>
                    <% amenitiesList.forEach(amenity => { %>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="amenities" value="<%= amenity %>" id="amenity_<%= amenity.replace(/\s+/g, '') %>">
                            <label class="form-check-label" for="amenity_<%= amenity.replace(/\s+/g, '') %>"><%= amenity %></label>
                        </div>
                    <% }) %>
                </div>
            </div>
            <div class="sidebar-footer">
                <button type="submit" class="btn btn-danger w-100">Apply Filters</button>
            </div>
        </form>
    </div>
</div>
<div class="sidebar-overlay" id="sidebar-overlay"></div>